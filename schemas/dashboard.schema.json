{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/dashboard.schema.json",
  "title": "ATLAS startup dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "surface", "plan_id", "timestamp", "duration_ms", "input_summary", "processing_summary", "output_summary", "goal", "task", "playbook", "frameworks", "sop", "output_profile", "plan_status", "clarification_status", "objective", "progress", "progress_visual", "active_stage", "active_unit", "completed_units", "total_units", "blocker_or_approval", "library", "quality_gate", "performance_mode"],
  "properties": {
    "system": {"const": "ATLAS"},
    "surface": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "plan_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_summary": {"type": "string", "minLength": 1},
    "processing_summary": {"type": "string", "minLength": 1},
    "output_summary": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "playbook": {"type": "string", "minLength": 1},
    "frameworks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sop": {"type": "string", "minLength": 1},
    "output_profile": {"type": "string", "pattern": "^output\\.[a-z0-9.-]+$"},
    "plan_status": {"enum": ["DRAFT", "READY", "BLOCKED"]},
    "clarification_status": {"enum": ["NOT_REQUIRED", "PENDING", "RESOLVED"]},
    "objective": {"type": "string", "minLength": 1},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "progress_visual": {"type": "string", "pattern": "^\\[[#-]{10}\\] [0-9]{1,3}%$"},
    "active_stage": {"type": "string", "minLength": 1},
    "active_unit": {"type": "string", "minLength": 1},
    "completed_units": {"type": "integer", "minimum": 0},
    "total_units": {"type": "integer", "minimum": 1},
    "execution_layer": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "request_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "confidence", "rationale_code", "specialist", "capability_requirements", "intelligence_types", "domain_context_mode", "collection_mode", "collection_required", "collection_types", "collection_depth", "collection_rationale_code"],
      "properties": {
        "route": {"enum": ["GENERAL_SEARCH", "GENERAL_TASK", "INTELLIGENCE"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale_code": {"type": "string", "minLength": 1},
        "specialist": {"type": ["string", "null"]},
        "capability_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "intelligence_types": {"type": "array", "items": {"enum": ["STRATEGIC_INTELLIGENCE", "MARKET_INTELLIGENCE", "OPPORTUNITY_INTELLIGENCE", "COMPETITIVE_INTELLIGENCE", "STAKEHOLDER_INTELLIGENCE", "POLITICAL_ECONOMIC_INTELLIGENCE", "MONITORING_INTELLIGENCE", "FORECASTING_INTELLIGENCE", "SCENARIO_INTELLIGENCE", "DECISION_INTELLIGENCE"]}, "uniqueItems": true},
        "domain_context_mode": {"enum": ["ON_DEMAND", "ARGUS_ENRICHES"]},
        "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
        "collection_required": {"type": "boolean"},
        "collection_types": {"type": "array", "items": {"enum": ["TARGET_PROFILE", "ENTITY_DOSSIER", "PRODUCT_CAPABILITY", "BUYER_REQUIREMENT", "PROCUREMENT_DISCOVERY", "PROCUREMENT_PLAN", "PROJECT_PIPELINE", "FUNDING_BUDGET", "SUPPLIER_LANDSCAPE", "COMPETITOR_LANDSCAPE", "STAKEHOLDER_NETWORK", "INSTALLED_BASE", "MARKET_LANDSCAPE", "OPPORTUNITY_DISCOVERY", "MONITORING"]}, "uniqueItems": true},
        "collection_depth": {"type": ["string", "null"], "enum": ["C0_IDENTITY", "C1_PROFILE", "C2_DOSSIER", "C3_OPPORTUNITY", "C4_MONITOR", null]},
        "collection_rationale_code": {"type": "string", "minLength": 1}
      }
    },
    "capability_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "routed", "specialist", "collection_mode", "collection_types", "task_classes", "reasons"],
      "properties": {
        "kernel": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "routed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "specialist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
        "collection_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "task_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reasons": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_health": {"enum": ["GREEN", "AMBER", "RED", "UNKNOWN"]},
    "highest_risk": {"type": ["string", "null"]},
    "blocker_or_approval": {"type": "string"},
    "pending_decision": {"type": ["string", "null"]},
    "outputs": {"type": "array"},
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "location", "format", "record_id"],
      "properties": {
        "status": {"enum": ["PENDING", "READY", "SAVED", "BLOCKED", "CAPABILITY_UNAVAILABLE"]},
        "location": {"type": ["string", "null"]},
        "format": {"enum": ["markdown", "json", "csv", "yaml", "html", "pdf", "mixed"]},
        "record_id": {"type": ["string", "null"]}
      }
    },
    "next_milestone": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "quality_gate": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED"]},
    "performance_mode": {"const": "LEAN"},
    "framework_alignment": {"enum": ["ALIGNED", "RESEARCH_REQUIRED", "NOT_APPLICABLE", "NOT_REQUIRED"]},
    "intent_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "matched_evidence", "candidate_requirements", "routing_authority"],
      "properties": {
        "category": {"enum": ["OPPORTUNITY_IDENTIFICATION", "SUPPLIER_VENDOR_SOURCING", "MARKET_VALIDATION", "GENERAL_RESEARCH", "GENERAL_TASK"]},
        "matched_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "routing_authority": {"const": "RECOMMEND_ONLY"},
        "request_route": {"enum": ["GENERAL_SEARCH", "GENERAL_TASK", "INTELLIGENCE"]},
        "intelligence_types": {"type": "array", "items": {"enum": ["STRATEGIC_INTELLIGENCE", "MARKET_INTELLIGENCE", "OPPORTUNITY_INTELLIGENCE", "COMPETITIVE_INTELLIGENCE", "STAKEHOLDER_INTELLIGENCE", "POLITICAL_ECONOMIC_INTELLIGENCE", "MONITORING_INTELLIGENCE", "FORECASTING_INTELLIGENCE", "SCENARIO_INTELLIGENCE", "DECISION_INTELLIGENCE"]}, "uniqueItems": true},
        "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
        "collection_required": {"type": "boolean"},
        "collection_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "collection_depth": {"type": ["string", "null"]}
      }
    },
    "behavioral_learning_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "persistence", "applied_preferences", "proposed_updates"],
      "properties": {
        "mode": {"enum": ["DISABLED", "SESSION_ONLY", "USER_AUTHORIZED"]},
        "persistence": {"enum": ["NOT_AUTHORIZED", "SESSION_ONLY", "HOST_MANAGED"]},
        "applied_preferences": {"type": "array"},
        "proposed_updates": {"type": "array"}
      }
    },
    "routing_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "objective", "task_id", "plan_id", "surface", "plan", "work_unit", "requirements", "intent_profile", "collection_mission", "activation_contract", "providers", "unmatched_requirements", "cyclic_provider_ids", "conflicting_provider_pairs", "missing_prerequisite_providers", "unresolved_gates", "execution_sequence", "steps", "approval_prompt", "digest"],
      "properties": {
        "status": {"enum": ["NOT_REQUIRED", "PROPOSED"]},
        "objective": {"type": "string", "minLength": 1},
        "task_id": {"type": ["string", "null"]},
        "plan_id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "plan": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "work_unit": {"type": ["string", "null"]},
        "requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "intent_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "matched_evidence", "candidate_requirements", "routing_authority"],
          "properties": {
            "category": {"enum": ["OPPORTUNITY_IDENTIFICATION", "SUPPLIER_VENDOR_SOURCING", "MARKET_VALIDATION", "GENERAL_RESEARCH", "GENERAL_TASK"]},
            "matched_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "candidate_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "routing_authority": {"const": "RECOMMEND_ONLY"},
            "request_route": {"enum": ["GENERAL_SEARCH", "GENERAL_TASK", "INTELLIGENCE"]},
            "intelligence_types": {"type": "array", "items": {"enum": ["STRATEGIC_INTELLIGENCE", "MARKET_INTELLIGENCE", "OPPORTUNITY_INTELLIGENCE", "COMPETITIVE_INTELLIGENCE", "STAKEHOLDER_INTELLIGENCE", "POLITICAL_ECONOMIC_INTELLIGENCE", "MONITORING_INTELLIGENCE", "FORECASTING_INTELLIGENCE", "SCENARIO_INTELLIGENCE", "DECISION_INTELLIGENCE"]}, "uniqueItems": true},
            "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
            "collection_required": {"type": "boolean"},
            "collection_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "collection_depth": {"type": ["string", "null"]}
          }
        },
        "collection_mission": {"type": ["object", "null"]},
        "activation_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "state", "activation_authority", "approval_required", "collection_mode", "argus_activation_required", "collection_mission_id", "provider_sequence", "handoff_provider_ids", "blockers"],
          "properties": {
            "version": {"const": "1.0"},
            "state": {"enum": ["NOT_REQUIRED", "READY_FOR_APPROVAL", "BLOCKED"]},
            "activation_authority": {"const": "ATLAS_OS"},
            "approval_required": {"type": "boolean"},
            "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
            "argus_activation_required": {"type": "boolean"},
            "collection_mission_id": {"type": ["string", "null"]},
            "provider_sequence": {"type": "array", "items": {"type": "string"}},
            "handoff_provider_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "unresolved_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "execution_sequence": {"type": "array", "items": {"type": "string"}},
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "name", "requirement", "purpose", "method", "permission", "authority", "risk_class", "version", "source", "prerequisites", "conflicts_with", "task_classes", "routing_task_class", "unresolved_gates", "data_scope", "fallback"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"enum": ["capability", "domain-method", "function", "model", "plugin", "skill", "subagent", "tool"]},
              "name": {"type": "string", "minLength": 1},
              "requirement": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "permission": {"enum": ["read", "write"]},
              "authority": {"type": "string", "minLength": 1},
              "risk_class": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "conflicts_with": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "task_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "routing_task_class": {"type": ["string", "null"]},
              "unresolved_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "data_scope": {"type": "string", "minLength": 1},
              "fallback": {"type": ["string", "null"]}
            }
          }
        },
        "unmatched_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cyclic_provider_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conflicting_provider_pairs": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}, "uniqueItems": true}},
        "missing_prerequisite_providers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "description"],
            "properties": {
              "stage": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "approval_prompt": {"type": ["string", "null"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "routing_decisions": {
      "type": "array",
      "items": {"type": "object", "required": ["status", "provider_id", "provider_type", "requirement", "reason", "preview_digest"]}
    }
  }
}