{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/dashboard.schema.json",
  "title": "ATLAS startup dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "surface", "plan_id", "timestamp", "duration_ms", "input_summary", "processing_summary", "output_summary", "goal", "task", "playbook", "frameworks", "sop", "output_profile", "plan_status", "clarification_status", "objective", "progress", "progress_visual", "active_stage", "active_unit", "completed_units", "total_units", "blocker_or_approval", "library", "quality_gate", "performance_mode"],
  "properties": {
    "system": {"const": "ATLAS"},
    "surface": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "plan_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_summary": {"type": "string", "minLength": 1},
    "processing_summary": {"type": "string", "minLength": 1},
    "output_summary": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "playbook": {"type": "string", "minLength": 1},
    "frameworks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sop": {"type": "string", "minLength": 1},
    "output_profile": {"type": "string", "pattern": "^output\\.[a-z0-9.-]+$"},
    "plan_status": {"enum": ["DRAFT", "READY", "BLOCKED"]},
    "clarification_status": {"enum": ["NOT_REQUIRED", "PENDING", "RESOLVED"]},
    "objective": {"type": "string", "minLength": 1},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "progress_visual": {"type": "string", "pattern": "^\\[[#-]{10}\\] [0-9]{1,3}%$"},
    "active_stage": {"type": "string", "minLength": 1},
    "active_unit": {"type": "string", "minLength": 1},
    "completed_units": {"type": "integer", "minimum": 0},
    "total_units": {"type": "integer", "minimum": 1},
    "execution_layer": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "evidence_health": {"enum": ["GREEN", "AMBER", "RED", "UNKNOWN"]},
    "highest_risk": {"type": ["string", "null"]},
    "blocker_or_approval": {"type": "string"},
    "pending_decision": {"type": ["string", "null"]},
    "outputs": {"type": "array"},
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "location", "format", "record_id"],
      "properties": {
        "status": {"enum": ["PENDING", "READY", "SAVED", "BLOCKED", "CAPABILITY_UNAVAILABLE"]},
        "location": {"type": ["string", "null"]},
        "format": {"enum": ["markdown", "json", "csv", "yaml", "html", "pdf", "mixed"]},
        "record_id": {"type": ["string", "null"]}
      }
    },
    "next_milestone": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "quality_gate": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED"]},
    "performance_mode": {"const": "LEAN"},
    "framework_alignment": {"enum": ["ALIGNED", "RESEARCH_REQUIRED", "NOT_APPLICABLE", "NOT_REQUIRED"]}
  }
}
