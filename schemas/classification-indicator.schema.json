{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os/schemas/classification-indicator.schema.json",
  "title": "ATLAS Classification Indicator Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["indicator_id", "name", "definition", "applicable_families", "value_type", "measure", "periodicity", "source_expectation", "stores_observations"],
  "properties": {
    "indicator_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "applicable_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "value_type": {"enum": ["NUMBER", "PERCENTAGE", "CURRENCY", "COUNT", "INDEX", "RATIO", "ORDINAL", "TEXT"]},
    "measure": {"type": "string", "minLength": 1},
    "direction": {"enum": ["HIGHER_IS_MORE", "LOWER_IS_MORE", "NEUTRAL", "CONTEXT_DEPENDENT"]},
    "periodicity": {"enum": ["EVENT", "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "ANNUAL", "IRREGULAR"]},
    "source_expectation": {"type": "string", "minLength": 1},
    "stores_observations": {"const": false},
    "notes": {"type": "string"}
  }
}