{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/capability-result.schema.json",
  "title": "ATLAS Capability Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "capability_version", "status", "objective", "findings", "evidence_refs", "assumptions", "contradictions", "unknowns", "limitations", "confidence", "recommended_next_actions", "verification_status", "execution_receipts", "provenance"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^(atlas|argus)\\.[a-z0-9-]+$"},
    "capability_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED"]},
    "objective": {"type": "string", "minLength": 1},
    "findings": {"type": "array"},
    "calculations": {"type": "array"},
    "artifacts": {"type": "array"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assumptions": {"type": "array"},
    "contradictions": {"type": "array"},
    "unknowns": {"type": "array"},
    "limitations": {"type": "array"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "recommended_next_actions": {"type": "array"},
    "verification_status": {"enum": ["NOT_REQUIRED", "PENDING", "PASS", "FAIL", "BLOCKED"]},
    "execution_receipts": {"type": "array"},
    "provenance": {"type": "object"}
  }
}
