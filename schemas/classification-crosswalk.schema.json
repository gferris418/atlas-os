{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/classification-crosswalk.schema.json",
  "title": "ATLAS Classification Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_scheme", "source_version", "source_code", "source_label", "target_scheme", "target_version", "target_code", "target_label", "relationship", "basis", "confidence", "verified", "provenance"],
  "properties": {
    "source_scheme": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "source_code": {"type": "string", "minLength": 1},
    "source_label": {"type": "string", "minLength": 1},
    "target_scheme": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1},
    "target_code": {"type": "string", "minLength": 1},
    "target_label": {"type": "string", "minLength": 1},
    "relationship": {"enum": ["EXACT", "CLOSE", "BROADER", "NARROWER", "RELATED"]},
    "basis": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verified": {"type": "boolean"},
    "provenance": {"type": "object"},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"}
  }
}
