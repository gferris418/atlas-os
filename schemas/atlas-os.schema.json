{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/atlas-os.schema.json",
  "title": "ATLAS-OS product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "authority", "architecture", "execution", "release", "artifacts"],
  "properties": {
    "schema": {"const": "schemas/atlas-os.schema.json"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "release_channel", "schema_version", "status", "classification", "license"],
      "properties": {
        "id": {"const": "atlas-os"},
        "name": {"const": "ATLAS OS"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "release_channel": {"enum": ["draft", "candidate", "stable"]},
        "schema_version": {"const": 2},
        "status": {"enum": ["DRAFT", "CANDIDATE", "VERIFIED", "RELEASED", "SUPERSEDED", "ARCHIVED"]},
        "classification": {"type": "string", "minLength": 1},
        "license": {"const": "MIT"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "ai_manifest", "governance", "core_spec", "version_pointer"],
      "properties": {
        "manifest": {"const": "atlas-os.yaml"},
        "ai_manifest": {"const": "atlas-ai.yaml"},
        "governance": {"const": "governance.yaml"},
        "core_spec": {"type": "string"},
        "version_pointer": {"const": "atlas-os.yaml#/product/version"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_control", "control_plane", "observability", "domain_intelligence"],
      "properties": {
        "mission_control": {"const": "spec/mission-control.yaml"},
        "control_plane": {"const": "spec/control-plane.yaml"},
        "observability": {"const": "spec/observability.yaml"},
        "domain_intelligence": {"const": "spec/domain-intelligence.yaml"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_triage", "spine", "runtime", "classification", "domain_practices", "domain_handoff", "output", "default_depth", "control_revision"],
      "properties": {
        "request_triage": {"const": "spec/request-triage.yaml"},
        "spine": {"type": "string"},
        "runtime": {"type": "string"},
        "classification": {"const": "spec/classification.yaml"},
        "domain_practices": {"const": "spec/domain-practices.yaml"},
        "domain_handoff": {"const": "spec/domain-handoff.yaml"},
        "output": {"const": "spec/output.yaml"},
        "default_depth": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "control_revision": {
          "type": "string",
          "pattern": "^atlas-bootstrap-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]+$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_version", "blocking_controls", "package_command", "validation_command"],
      "properties": {
        "target_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "blocking_controls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "package_command": {"type": "string"},
        "validation_command": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["governance", "specifications", "schemas", "registries", "integrations", "migrations", "tests"]
    }
  }
}
