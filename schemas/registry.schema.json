{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/registry.schema.json",
  "title": "ATLAS registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry", "items"],
  "properties": {
    "schema": {"const": "schemas/registry.schema.json"},
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "version", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^registry\\.[a-z0-9.-]+$"},
        "type": {"enum": ["capability", "tool", "skill", "surface", "control", "migration", "framework", "taxonomy", "classification", "output-profile"]},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "draft", "deprecated"]}
      }
    },
    "items": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"enum": ["active", "available", "required", "open", "blocked", "deprecated", "unsupported"]},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "conflicts_with": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "fallback": {"type": ["string", "null"]},
          "authority": {"type": "string"},
          "permission": {"type": "string"},
          "risk_class": {"type": "string"},
          "priority": {"type": "integer"},
          "version": {"type": "string"},
          "source": {"type": "string"},
          "path": {"type": "string"},
          "release_blocking": {"type": "boolean"},
          "triggers": {"type": "array", "items": {"type": "string"}},
          "applies_to": {"type": "array", "items": {"type": "string"}},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "issuer": {"type": "string", "minLength": 1},
          "official_source": {"type": "string", "format": "uri"},
          "jurisdictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "version_policy": {"enum": ["current-official", "explicitly-pinned"]},
          "applicability": {"type": "string"},
          "classification_scope": {"enum": ["terminology", "knowledge-organization", "metadata", "geography", "economic-activity", "products-services", "customs", "procurement", "defense-logistics", "internal-capability"]},
          "facet": {"enum": ["jurisdiction", "operator-industry", "supplier-industry", "product-or-service", "capability", "lifecycle-stage", "stakeholder", "information-sensitivity"]},
          "taxonomy": {"type": "string", "pattern": "^taxonomy\\.[a-z0-9.-]+$"},
          "code": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "match_all": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "risk_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "format": {"enum": ["markdown", "json", "csv", "yaml", "html", "pdf", "mixed"]},
          "supported_formats": {"type": "array", "items": {"enum": ["markdown", "json", "csv", "yaml", "html", "pdf", "mixed"]}, "uniqueItems": true},
          "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "optional_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "outcome_first": {"type": "boolean"},
          "citations": {"enum": ["not-required", "when-material", "required"]},
          "visuals": {"enum": ["none", "only-when-materially-clearer", "required"]},
          "max_initial_sections": {"type": "integer", "minimum": 1, "maximum": 8},
          "machine_readable": {"type": "boolean"},
          "validation_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "standards": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "task_classes": {"type": "array", "items": {"enum": ["ANSWER", "RESEARCH", "ANALYSIS", "DECISION", "WRITING", "DOCUMENT", "DATA", "CODING", "DEBUGGING", "DESIGN", "PLANNING", "WORKFLOW", "EXTERNAL_ACTION", "MONITORING", "MULTI_STAGE"]}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  }
}

