{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/registry.schema.json",
  "title": "ATLAS registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry", "items"],
  "properties": {
    "schema": {"const": "schemas/registry.schema.json"},
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "version", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^registry\\.[a-z0-9.-]+$"},
        "type": {"enum": ["capability", "tool", "skill", "surface", "control", "migration"]},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "draft", "deprecated"]}
      }
    },
    "items": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"enum": ["active", "available", "required", "open", "blocked", "deprecated", "unsupported"]},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "conflicts_with": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "fallback": {"type": ["string", "null"]},
          "authority": {"type": "string"},
          "permission": {"type": "string"},
          "risk_class": {"type": "string"},
          "priority": {"type": "integer"},
          "version": {"type": "string"},
          "source": {"type": "string"},
          "path": {"type": "string"},
          "release_blocking": {"type": "boolean"},
          "triggers": {"type": "array", "items": {"type": "string"}},
          "applies_to": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  }
}

