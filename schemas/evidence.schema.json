{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/evidence.schema.json",
  "title": "ATLAS evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "status", "sources"],
  "properties": {
    "claim": {"type": "string", "minLength": 1},
    "status": {"enum": ["CONFIRMED", "PROBABLE", "POSSIBLE", "DISPUTED", "UNVERIFIED", "STALE"]},
    "sources": {"type": "array", "items": {"type": "string"}},
    "inference": {"type": ["string", "null"]}
  }
}
