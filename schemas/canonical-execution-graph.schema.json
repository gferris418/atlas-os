{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/canonical-execution-graph.schema.json",
  "title": "ATLAS Canonical Execution Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "version", "nodes"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "serial", "title", "kind"],
      "properties": {
        "stable_id": {"type": "string", "minLength": 1},
        "serial": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
        },
        "title": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"], "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["REQUIRED", "CONDITIONAL", "OPTIONAL"]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "criticality": {
          "type": "string",
          "enum": ["CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"]
        },
        "owner": {"type": "string", "minLength": 1},
        "condition": {"type": ["string", "null"]},
        "input_schema_ref": {"type": ["string", "null"]},
        "output_schema_ref": {"type": ["string", "null"]},
        "evidence_requirement": {"type": ["string", "null"]}
      }
    }
  }
}
