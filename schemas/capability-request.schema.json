{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/capability-request.schema.json",
  "title": "ATLAS Capability Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "task_id", "plan_id", "objective", "task_intent", "collection_mode", "evidence_standard", "requested_output"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "task_intent": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ANSWER", "RESEARCH", "ANALYSIS", "DECISION", "WRITING", "DOCUMENT", "DATA", "CODING", "DEBUGGING", "DESIGN", "PLANNING", "WORKFLOW", "EXTERNAL_ACTION", "MONITORING", "MULTI_STAGE"]}},
    "target_objects": {"type": "array", "items": {"type": "object"}},
    "supplied_material": {"type": "array", "items": {"type": "object"}},
    "known_facts": {"type": "array"},
    "jurisdiction": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "geography": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "time_horizon": {"type": ["string", "null"]},
    "freshness_requirement": {"enum": ["NONE", "CURRENT", "RECENT", "HISTORICAL", "MIXED"]},
    "domain_context": {"type": ["object", "null"]},
    "taxonomy_context": {"type": ["object", "null"]},
    "collection_mode": {"enum": ["NONE", "ATLAS_DIRECT", "ARGUS_COLLECTION", "HYBRID"]},
    "evidence_standard": {"enum": ["NONE", "BASIC", "SOURCED", "CORROBORATED", "DECISION_GRADE"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authorization": {"type": ["object", "null"]},
    "requested_output": {"type": "object"}
  }
}
