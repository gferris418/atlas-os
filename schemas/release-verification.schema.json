{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/release-verification.schema.json",
  "title": "ATLAS external surface release verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "surface",
    "product_version",
    "control_revision",
    "status",
    "fresh_session_required",
    "independent_evidence_required",
    "authority",
    "checks",
    "evidence_requirements",
    "controls"
  ],
  "properties": {
    "schema": {"const": "schemas/release-verification.schema.json"},
    "id": {"type": "string", "pattern": "^verification\\.[a-z0-9.-]+$"},
    "surface": {"enum": ["chatgpt", "codex", "work", "hermes-agent"]},
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "control_revision": {
      "type": "string",
      "pattern": "^atlas-bootstrap-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]+$"
    },
    "status": {"enum": ["READY_FOR_EXTERNAL_PROOF", "PASS", "FAIL", "BLOCKED"]},
    "fresh_session_required": {"type": "boolean"},
    "independent_evidence_required": {"type": "boolean"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_manifest", "ai_manifest", "adapter"],
      "properties": {
        "product_manifest": {"const": "atlas-os.yaml"},
        "ai_manifest": {"const": "atlas-ai.yaml"},
        "adapter": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "input", "assertions", "required_evidence", "controls"],
        "properties": {
          "id": {"type": "string", "pattern": "^CHK-[0-9]{2}$"},
          "kind": {"enum": ["prompt", "inspection", "action"]},
          "input": {"type": "string", "minLength": 1},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "property", "operator", "expected"],
              "properties": {
                "id": {"type": "string", "pattern": "^AST-[0-9]{2}$"},
                "property": {"type": "string", "minLength": 1},
                "operator": {
                  "enum": ["equals", "contains", "present", "absent", "one-of", "requires-approval"]
                },
                "expected": {
                  "type": ["string", "boolean", "number", "array", "null"],
                  "items": {"type": ["string", "number", "boolean"]}
                }
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^MIG-[0-9]{3}$"}
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MIG-[0-9]{3}$"}
    }
  }
}
