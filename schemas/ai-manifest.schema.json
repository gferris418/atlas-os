{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/ai-manifest.schema.json",
  "title": "ATLAS-OS AI discovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "product_version",
    "control_revision",
    "authority",
    "discovery_order",
    "machine_contracts",
    "human_guidance",
    "external_verification"
  ],
  "properties": {
    "schema": {"const": "schemas/ai-manifest.schema.json"},
    "id": {"const": "atlas-os-ai-entrypoint"},
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "control_revision": {
      "type": "string",
      "pattern": "^atlas-bootstrap-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_manifest",
        "core_spec",
        "execution_spine",
        "runtime_spec",
        "schema_catalog",
        "registry_catalog",
        "migration_catalog"
      ],
      "properties": {
        "product_manifest": {"const": "atlas-os.yaml"},
        "core_spec": {"const": "spec/core.yaml"},
        "execution_spine": {"const": "spec/execution-spine.yaml"},
        "runtime_spec": {"const": "spec/runtime.yaml"},
        "schema_catalog": {"const": "schemas"},
        "registry_catalog": {"const": "registries"},
        "migration_catalog": {"const": "migration"}
      }
    },
    "discovery_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "machine_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+\\.(?:yaml|yml|json)$"
      }
    },
    "human_guidance": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+\\.md$"
      }
    },
    "external_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "control_registry", "controls", "surfaces"],
      "properties": {
        "schema": {"const": "schemas/release-verification.schema.json"},
        "control_registry": {"const": "registries/migrations.yaml"},
        "controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MIG-[0-9]{3}$"}
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["chatgpt", "codex", "work", "hermes-agent"]}
        }
      }
    }
  }
}
