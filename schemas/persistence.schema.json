{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/persistence.schema.json",
  "title": "ATLAS durable state record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "namespace", "version", "timestamp", "timezone", "provenance", "status", "dependencies", "replaces"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "namespace": {"enum": ["TASK", "CANONICAL_LIBRARY"]},
    "version": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "minProperties": 1},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "ARCHIVED"]},
    "delivery_status": {"enum": ["READY", "SAVED", "BLOCKED", "CAPABILITY_UNAVAILABLE"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "replaces": {"type": ["string", "null"]},
    "format": {"enum": ["markdown", "json", "csv", "yaml", "html", "pdf", "mixed"]},
    "collection": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$"},
    "location": {"type": ["string", "null"]},
    "persistence_evidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "location", "checksum", "bytes_written", "verified_at"],
          "properties": {
            "adapter": {"type": "string", "minLength": 1},
            "location": {"type": "string", "minLength": 1},
            "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "bytes_written": {"type": "integer", "minimum": 0},
            "verified_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {
        "required": ["namespace"],
        "properties": {"namespace": {"const": "CANONICAL_LIBRARY"}}
      },
      "then": {
        "required": ["delivery_status", "format", "collection", "location", "persistence_evidence"]
      }
    },
    {
      "if": {
        "required": ["delivery_status"],
        "properties": {"delivery_status": {"const": "SAVED"}}
      },
      "then": {
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "persistence_evidence": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "required": ["delivery_status"],
        "properties": {"delivery_status": {"enum": ["BLOCKED", "CAPABILITY_UNAVAILABLE"]}}
      },
      "then": {"properties": {"location": {"type": "null"}}}
    }
  ]
}

