{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/migration.schema.json",
  "title": "ATLAS migration control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "description", "status", "release_blocking", "opened_at", "closed_at", "dependencies", "acceptance_criteria", "evidence", "owner", "notes"],
  "properties": {
    "schema": {"const": "schemas/migration.schema.json"},
    "id": {"type": "string", "pattern": "^(MIG-[0-9]{3}|DTIF-RECONCILIATION)$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "BLOCKED", "IN_PROGRESS", "CLOSED"]},
    "release_blocking": {"type": "boolean"},
    "opened_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "owner": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "CLOSED"}}},
    "then": {
      "properties": {
        "closed_at": {"type": "string", "format": "date-time"},
        "evidence": {"minItems": 1}
      }
    }
  }]
}

