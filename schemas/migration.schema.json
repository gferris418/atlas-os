{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/migration.schema.json",
  "title": "ATLAS migration control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "description",
    "status",
    "release_blocking",
    "opened_at",
    "closed_at",
    "dependencies",
    "acceptance_criteria",
    "evidence",
    "owner",
    "notes"
  ],
  "properties": {
    "schema": {"const": "schemas/migration.schema.json"},
    "id": {"type": "string", "pattern": "^(MIG-[0-9]{3}|DTIF-RECONCILIATION)$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "BLOCKED", "IN_PROGRESS", "CLOSED"]},
    "release_blocking": {"type": "boolean"},
    "opened_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(MIG-[0-9]{3}|DTIF-RECONCILIATION)$"},
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/acceptanceCriterion"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "owner": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "surfaces",
        "evidence_type",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]{2}$"},
        "requirement": {"type": "string", "minLength": 1},
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "repository",
              "chatgpt",
              "codex",
              "work",
              "hermes-agent",
              "generic-ai-host",
              "external-system"
            ]
          }
        },
        "evidence_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "BLOCKED", "PASS"]},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EVID-[0-9]{3}$"}
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "timestamp",
        "result",
        "source",
        "independent",
        "scope",
        "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^EVID-[0-9]{3}$"},
        "type": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "control_revision": {"type": "string", "minLength": 1},
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "READY_FOR_EXTERNAL_PROOF",
            "DEFERRED_POST_GA",
            "NOT_APPLICABLE"
          ]
        },
        "source": {"type": "string", "minLength": 1},
        "independent": {"type": "boolean"},
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {"type": "string"},
        "details": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CLOSED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "closed_at": {"type": "string", "format": "date-time"},
          "evidence": {"minItems": 1},
          "acceptance_criteria": {
            "items": {
              "properties": {"status": {"const": "PASS"}},
              "required": ["status"]
            }
          }
        }
      },
      "else": {
        "properties": {"closed_at": {"type": "null"}}
      }
    }
  ]
}
