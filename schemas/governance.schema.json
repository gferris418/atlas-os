{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/governance.schema.json",
  "title": "ATLAS-OS governance policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "version", "authority", "change", "release", "evidence",
    "approvals", "domain", "retention", "migration", "legacy"
  ],
  "properties": {
    "schema": {"const": "schemas/governance.schema.json"},
    "id": {"const": "atlas-os-governance"},
    "version": {"type": "integer", "minimum": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_manifest", "ai_manifest", "core_spec", "precedence", "human_companion"],
      "properties": {
        "product_manifest": {"const": "atlas-os.yaml"},
        "ai_manifest": {"const": "atlas-ai.yaml"},
        "core_spec": {"const": "spec/core.yaml"},
        "precedence": {
          "type": "array",
          "prefixItems": [
            {"const": "product-manifest"},
            {"const": "governance-policy"},
            {"const": "ai-discovery"},
            {"const": "core-specifications"},
            {"const": "schemas"},
            {"const": "registries"},
            {"const": "integration-contracts"},
            {"const": "active-migrations"},
            {"const": "human-guidance"},
            {"const": "legacy"}
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "human_companion": {"const": "GOVERNANCE.md"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "strong_review_for"],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["PATCH", "MINOR", "MAJOR", "MIGRATION", "GOVERNANCE", "DOCUMENTATION", "REGISTRY", "INTEGRATION"]}
        },
        "strong_review_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["runtime-semantics", "schemas", "persistence", "compatibility", "release-gates", "authority", "security"]}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "distinct_states", "released_requires_no_open_blockers", "missing_evidence_is_pass", "candidate_packaging_allowed_with_truthful_blockers"],
      "properties": {
        "lifecycle": {
          "type": "array",
          "prefixItems": [
            {"const": "DRAFT"}, {"const": "CANDIDATE"}, {"const": "VERIFIED"},
            {"const": "RELEASED"}, {"const": "SUPERSEDED"}, {"const": "ARCHIVED"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "distinct_states": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["generation", "execution", "verification", "acceptance", "release"]}
        },
        "released_requires_no_open_blockers": {"const": true},
        "missing_evidence_is_pass": {"const": false},
        "candidate_packaging_allowed_with_truthful_blockers": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "material_claims_require_provenance", "model_output_is_verified_evidence"],
      "properties": {
        "spec": {"const": "spec/evidence.yaml"},
        "material_claims_require_provenance": {"const": true},
        "model_output_is_verified_evidence": {"const": false}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "scoped", "gated_actions"],
      "properties": {
        "spec": {"const": "spec/approvals.yaml"},
        "scoped": {"const": true},
        "gated_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["destructive-action", "irreversible-action", "publication", "financial-commitment", "external-communication", "permission-change", "security-sensitive-change", "major-canonical-write"]}
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practices_spec", "framework_registry", "current_official_sources_required", "alignment_is_not_certification", "binding_requirements_take_precedence"],
      "properties": {
        "practices_spec": {"const": "spec/domain-practices.yaml"},
        "framework_registry": {"const": "registries/frameworks.yaml"},
        "current_official_sources_required": {"const": true},
        "alignment_is_not_certification": {"const": true},
        "binding_requirements_take_precedence": {"const": true}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readily_available_revisions", "archive_requires", "silent_overwrite"],
      "properties": {
        "readily_available_revisions": {"type": "integer", "minimum": 3},
        "archive_requires": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["dependent-replacement", "migration-complete", "audit-permission"]}
        },
        "silent_overwrite": {"const": false}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "registry", "blockers_close_only_with_evidence", "closed_requires_all_criteria_pass", "deprecated_material_requires_replacement_lineage"],
      "properties": {
        "schema": {"const": "schemas/migration.schema.json"},
        "registry": {"const": "registries/migrations.yaml"},
        "blockers_close_only_with_evidence": {"const": true},
        "closed_requires_all_criteria_pass": {"const": true},
        "deprecated_material_requires_replacement_lineage": {"const": true}
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "immutable", "active_resolution_to_legacy"],
      "properties": {
        "root": {"const": "legacy"},
        "immutable": {"const": true},
        "active_resolution_to_legacy": {"const": false}
      }
    }
  }
}
