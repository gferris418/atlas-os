{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/task.schema.json",
  "title": "ATLAS task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "objective", "status", "classification", "execution_depth", "dependencies", "inputs", "outputs", "evidence", "approvals", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "ACTIVE", "BLOCKED", "PARTIAL", "COMPLETED", "FAILED", "CANCELLED"]},
    "classification": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["ANSWER", "RESEARCH", "ANALYSIS", "DECISION", "WRITING", "DOCUMENT", "DATA", "CODING", "DEBUGGING", "DESIGN", "PLANNING", "WORKFLOW", "EXTERNAL_ACTION", "MONITORING", "MULTI_STAGE"]}
    },
    "execution_depth": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "evidence": {"type": "array"},
    "approvals": {"type": "array"},
    "verification": {"type": "array"},
    "assumptions": {"type": "array"},
    "domain_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "facets", "taxonomy_references", "risk_flags", "unresolved_facets", "conditional_candidates", "evidence", "next_action"],
      "properties": {
        "status": {"enum": ["CLASSIFIED", "PARTIAL", "RESEARCH_REQUIRED", "NOT_REQUIRED"]},
        "facets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "taxonomy", "code", "label", "version", "source"],
              "properties": {
                "id": {"type": "string"},
                "taxonomy": {"type": "string", "pattern": "^taxonomy\\."},
                "code": {"type": "string"},
                "label": {"type": "string"},
                "version": {"type": "string"},
                "source": {"type": ["string", "null"]}
              }
            }
          }
        },
        "taxonomy_references": {"type": "array", "items": {"type": "string", "pattern": "^taxonomy\\."}, "uniqueItems": true},
        "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unresolved_facets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conditional_candidates": {"type": "array"},
        "evidence": {"type": "array"},
        "next_action": {"type": ["string", "null"]}
      }
    },
    "domain_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "status", "frameworks", "applicability", "deviations", "compliance", "evidence"],
      "properties": {
        "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "status": {"enum": ["ALIGNED", "RESEARCH_REQUIRED", "NOT_APPLICABLE"]},
        "frameworks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "applicability": {"type": "object"},
        "deviations": {"type": "array"},
        "compliance": {"enum": ["VERIFIED", "SUPPORTED", "UNVERIFIED", "NOT_CLAIMED"]},
        "evidence": {"type": "array"}
      }
    }
  },
  "allOf": [{
    "if": {
      "properties": {
        "execution_depth": {"enum": ["L1", "L2", "L3", "L4"]}
      },
      "required": ["execution_depth"]
    },
    "then": {"required": ["domain_classification", "domain_alignment"]}
  }]
}

