{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/output.schema.json",
  "title": "ATLAS output record",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "content", "verification"],
  "properties": {
    "status": {"enum": ["READY", "PARTIAL", "BLOCKED", "COMPLETED"]},
    "content": {},
    "verification": {"type": "object"},
    "persistence": {"type": ["object", "null"]}
  }
}
