{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/approval.schema.json",
  "title": "ATLAS approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "status", "scope", "reusable"],
  "properties": {
    "action": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "STALE"]},
    "scope": {"type": "string", "minLength": 1},
    "bound_digest": {"type": ["string", "null"]},
    "reusable": {"const": false}
  }
}
